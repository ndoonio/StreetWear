<?xml version="1.0" encoding="UTF-8"?>

<web-app xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
                             http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         id="WebApp_ID"
         version="4.0">

    <display-name>StreetWear</display-name>

    <welcome-file-list>
        <welcome-file>Home</welcome-file>
    </welcome-file-list>

    <!-- Pagina personalizzata per errore 404: pagina non trovata -->
    <error-page>
        <error-code>404</error-code>
        <location>/WEB-INF/views/errors/error-404.jsp</location>
    </error-page>

    <!-- Pagina personalizzata per errore 500: errore interno del server -->
    <error-page>
        <error-code>500</error-code>
        <location>/WEB-INF/views/errors/error-500.jsp</location>
    </error-page>

    <!-- Pagina personalizzata per errore 403: accesso negato -->
    <error-page>
        <error-code>403</error-code>
        <location>/WEB-INF/views/errors/error-403.jsp</location>
    </error-page>

    <!-- Pagina generica per qualunque eccezione Java non gestita -->
    <error-page>
        <exception-type>java.lang.Throwable</exception-type>
        <location>/WEB-INF/views/errors/error-500.jsp</location>
    </error-page>

</web-app>